class Serializer {
  + {static} saveBinary(arr : const DynamicArray&, filename : const std::string&) : bool
  + {static} loadBinary(filename : const std::string&) : DynamicArray
}

class TextSerializer {
  - {static} escape(s : const std::string&) : std::string
  - {static} unescape(s : const std::string&) : std::string
  + {static} saveText(list : const SinglyList&, filename : const std::string&) : bool
  + {static} loadText(filename : const std::string&) : SinglyList
}

Serializer ..> DynamicArray : бинарная сериализация
TextSerializer ..> SinglyList : текстовая сериализация
@enduml
